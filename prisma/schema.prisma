generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    SUPER_ADMIN
    ADMIN
    USER
}

model User {
    id           String         @id @default(nanoid())
    studentId    String         @unique
    name         String
    givenName    String
    familyName   String
    picture      String
    email        String         @unique
    role         UserRole       @default(USER)
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    UserSettings UserSettings[]
}

model UserSettings {
    id     String @id @default(nanoid())
    userId String @unique
    user   User   @relation(fields: [userId], references: [id])
}

model student {
    userid            String @id
    password          String
    lineid            String
    email             String
    img               String
    name              String
    enName            String
    IDNumber          String
    status            String
    major             String
    gender            String
    birthday          String
    birthplace        String
    address           String
    phone             String
    homePhone         String
    date              String
    previousEducation String
    parentName        String
    parentAddress     String
    parentPhone       String
    parentJob         String
    desc              String @db.Text
}

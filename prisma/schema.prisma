generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model student {
    userid            String @id
    password          String
    lineid            String
    email             String
    img               String
    name              String
    enName            String
    IDNumber          String
    status            String
    major             String
    gender            String
    birthday          String
    birthplace        String
    address           String
    phone             String
    homePhone         String
    date              String
    previousEducation String
    parentName        String
    parentAddress     String
    parentPhone       String
    parentJob         String
    desc              String @db.Text
}

model user {
    userid String @id @db.VarChar(9)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id
  name         String
  givenName    String
  familyName   String
  picture      String
  email        String        @unique
  role         UserRole      @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Log          Log[]
  UserSettings UserSettings?
  Download     Download[]
}

model UserSettings {
  id       String  @id @default(nanoid())
  theme    String
  location Boolean
  avatar   String
  banner   String
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
}

model Student {
  userId            String @id
  password          String
  lineId            String
  email             String
  img               String
  name              String
  enName            String
  IDNumber          String
  status            String
  major             String
  gender            String
  birthday          String
  birthplace        String
  address           String
  phone             String
  homePhone         String
  date              String
  previousEducation String
  parentName        String
  parentAddress     String
  parentPhone       String
  parentJob         String
  desc              String @db.Text
}

model Log {
  id             String   @id @default(nanoid())
  ip             String
  userId         String
  browserName    String
  browserVersion String
  deviceModel    String
  deviceType     String
  deviceVendor   String
  osName         String
  osVersion      String
  referer        String
  path           String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Log_userId_fkey")
}

model Download {
  id        String   @id @default(nanoid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId], map: "Download_userId_fkey")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}
